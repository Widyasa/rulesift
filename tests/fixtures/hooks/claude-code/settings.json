{
  "permissions": { "allow": ["Read"] },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "echo checking bash", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "prompt", "prompt": "Check that all tasks are done." },
          { "type": "command", "command": "echo stopped" }
        ]
      }
    ]
  }
}
